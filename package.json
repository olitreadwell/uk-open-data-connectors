{
  "name": "uk-open-data-connectors",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.23.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @uk-open-data-connectors/uk-sources && npm run build -w @uk-open-data-connectors/uk-mcp && npm run build -w @uk-open-data-connectors/connectors-cli",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:smoke": "npm run test:smoke --workspaces --if-present",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit": "npm audit",
    "check": "npm run format:check && npm run build && npm run lint && npm run type-check && npm run test:coverage",
    "type-check": "npm run type-check --workspaces --if-present",
    "dev:api": "npm run dev -w @uk-open-data-connectors/connectors-api",
    "start:api": "npm run start -w @uk-open-data-connectors/connectors-api"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "@vitest/coverage-v8": "3.2.7"
  },
  "dependencies": {},
  "description": "UK open data connectors: TypeScript adapters for UK public data sources, with an HTTP API and a CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olitreadwell/uk-open-data-connectors.git"
  },
  "homepage": "https://github.com/olitreadwell/uk-open-data-connectors#readme",
  "bugs": {
    "url": "https://github.com/olitreadwell/uk-open-data-connectors/issues"
  }
}
