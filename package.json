{
  "name": "uk-open-data-connectors",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @open-data-connectors/uk-sources -w @open-data-connectors/connectors-cli",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:smoke": "npm run test:smoke --workspaces --if-present",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit": "npm audit",
    "check": "npm run format:check && npm run build && npm run lint && npm run type-check && npm run test:coverage",
    "type-check": "npm run type-check --workspaces --if-present",
    "dev:api": "npm run dev -w @open-data-connectors/connectors-api",
    "start:api": "npm run start -w @open-data-connectors/connectors-api"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "@vitest/coverage-v8": "3.2.7"
  },
  "dependencies": {},
  "description": "UK open data connectors: TypeScript adapters for UK public data sources, with an HTTP API and a CLI."
}
