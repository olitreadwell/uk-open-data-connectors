{
  "name": "@uk-open-data-connectors/connectors-cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "ukdata": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage",
    "clean:all": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage node_modules"
  },
  "dependencies": {
    "@uk-open-data-connectors/uk-sources": "*"
  },
  "devDependencies": {
    "@uk-open-data-connectors/config-eslint": "*",
    "@uk-open-data-connectors/config-typescript": "*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olitreadwell/uk-open-data-connectors.git"
  },
  "homepage": "https://github.com/olitreadwell/uk-open-data-connectors#readme",
  "bugs": {
    "url": "https://github.com/olitreadwell/uk-open-data-connectors/issues"
  }
}
