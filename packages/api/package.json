{
  "name": "@uk-open-data-connectors/connectors-api",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/**"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "RUN_SMOKE=1 vitest run src/smoke.test.ts",
    "clean": "rm -rf tsconfig.tsbuildinfo coverage",
    "clean:all": "rm -rf tsconfig.tsbuildinfo coverage node_modules"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-validator": "0.9.1",
    "@uk-open-data-connectors/uk-sources": "*",
    "@sentry/node": "10.75.3",
    "hono": "4.13.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@uk-open-data-connectors/config-eslint": "*",
    "@uk-open-data-connectors/config-typescript": "*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olitreadwell/uk-open-data-connectors.git"
  },
  "homepage": "https://github.com/olitreadwell/uk-open-data-connectors#readme",
  "bugs": {
    "url": "https://github.com/olitreadwell/uk-open-data-connectors/issues"
  }
}
